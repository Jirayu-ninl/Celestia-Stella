{
  "name": "@celestia/stella",
  "version": "2025.07.1301",
  "private": true,
  "homepage": "https://theiceji.com",
  "scripts": {
    "format": "bunx biome format --write",
    "lint": "bunx biome lint --write",
    "check": "bunx biome check --write",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db": "bun db:generate && bun db:push",
    "dev": "infisical run --path=/Stella -- bun run --hot src/index.ts",
    "build:dev": "bun pipeline/build && bun run sentry:sourcemaps:dev",
    "build:prod": "bun pipeline/build && bun run sentry:sourcemaps:prod",
    "dryrun:build": "infisical run --path=/Stella --env=staging -- bun run build:dev",
    "start": "bun run dist/index.js",
    "prod": "bun run db && bun run build:prod",
    "node:dev": "infisical run --path=/Stella -- tsx watch src/index.ts",
    "node:build:dev": "tsc && npm run sentry:sourcemaps:dev",
    "node:build:prod": "tsc && npm run sentry:sourcemaps:prod",
    "node:dryrun:build": "infisical run --path=/Stella --env=staging -- npm run build:dev",
    "node:start": "node dist/index.js",
    "env:validate": "bun run -e 'import(\"./global/env\").then(() => console.log(\"✅ Environment valid\"))'",
    "sentry:sourcemaps:dev": "sentry-cli sourcemaps inject --org theiceji-dev --project stella ./dist && sentry-cli sourcemaps upload --org theiceji-dev --project stella ./dist",
    "sentry:sourcemaps:prod": "sentry-cli sourcemaps inject --org theiceji --project stella ./dist && sentry-cli sourcemaps upload --org theiceji --project stella ./dist"
  },
  "prisma": {
    "schema": "packages/prisma/schema/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "@aws-sdk/lib-storage": "^3.844.0",
    "@aws-sdk/s3-request-presigner": "^3.844.0",
    "@axiomhq/js": "^1.3.1",
    "@axiomhq/logging": "^0.1.4",
    "@axiomhq/nextjs": "^0.1.4",
    "@axiomhq/react": "^0.1.4",
    "@hono/zod-validator": "^0.7.0",
    "@prisma/client": "^6.11.1",
    "@sentry/bun": "^9.38.0",
    "@sentry/cli": "^2.47.0",
    "bcryptjs": "^3.0.2",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "hono": "^4.8.4",
    "lodash-es": "^4.17.21",
    "nodemailer": "^7.0.5",
    "sharp": "^0.34.3",
    "stripe": "^18.3.0",
    "uuidv7": "^1.0.2",
    "vitest": "^3.2.4",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/bun": "^1.2.18",
    "@types/lodash-es": "^4.17.12",
    "cross-env": "^7.0.3",
    "prisma": "^6.11.1",
    "prisma-dbml-generator": "^0.12.0",
    "typescript": "^5.8.3"
  }
}