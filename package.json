{
  "name": "@celestia/stella",
  "version": "2025.07.1201",
  "private": true,
  "homepage": "https://theiceji.com",
  "scripts": {
    "format": "bunx biome format --write",
    "lint": "bunx biome lint --write",
    "check": "bunx biome check --write",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db": "bun db:generate && bun db:push",
    "dev": "infisical run -- bun run --hot src/index.ts",
    "build": "infisical run -- bun pipeline/build",
    "build:standalone": "infisical run -- bun pipeline/build/standalone",
    "start": "bun run dist/index.js",
    "node:dev": "infisical run -- tsx watch src/index.ts",
    "node:build": "infisical run -- tsc",
    "node:start": "node dist/index.js",
    "env:validate": "bun run -e 'import(\"./global/env\").then(() => console.log(\"✅ Environment valid\"))'"
  },
  "prisma": {
    "schema": "packages/prisma/schema/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@aws-sdk/lib-storage": "^3.842.0",
    "@aws-sdk/s3-request-presigner": "^3.842.0",
    "@axiomhq/js": "^1.3.1",
    "@axiomhq/logging": "^0.1.4",
    "@axiomhq/nextjs": "^0.1.4",
    "@axiomhq/react": "^0.1.4",
    "@hono/zod-validator": "^0.7.0",
    "@prisma/client": "^6.11.1",
    "@sentry/bun": "^9.38.0",
    "bcryptjs": "^3.0.2",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "hono": "^4.8.4",
    "lodash-es": "^4.17.21",
    "nodemailer": "^7.0.5",
    "sharp": "^0.34.2",
    "stripe": "^18.3.0",
    "uuidv7": "^1.0.2",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "@types/bun": "latest",
    "@types/lodash-es": "^4.17.12",
    "cross-env": "^7.0.3",
    "prisma": "^6.11.1",
    "prisma-dbml-generator": "^0.12.0",
    "typescript": "^5.8.3"
  }
}